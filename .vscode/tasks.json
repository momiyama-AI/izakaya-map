{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DB: initialize SQLite",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\init-db.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Dev: start app",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\dev.ps1"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Deploy: local production",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\deploy-local.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Test: smoke",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\smoke-test.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "Deploy: stop local",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\stop-local.ps1"
      ],
      "problemMatcher": []
    }
  ]
}
